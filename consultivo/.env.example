# Banco de dados (padrão: SQLite local; para produção, use Postgres)
DATABASE_URL=sqlite:///./data/consultivo.db

# IA — opcional. SEM chave, o sistema mede os atendimentos por heurística.
# Com chave, usa o Claude para resumir/classificar/estimar esforço.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# WhatsApp Business Cloud API (canal OFICIAL da Meta, número dedicado)
WA_VERIFY_TOKEN=mensura-verify
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v21.0

# Segmentação e valoração
SEGMENT_GAP_MINUTES=360      # intervalo (min) que encerra um atendimento
VALOR_HORA_PADRAO=350        # hora de referência quando o cliente não tem uma própria
