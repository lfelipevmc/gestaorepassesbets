# ---- Banco de dados ----
# SQLite (padrão, sem configuração) — troque por Postgres em produção:
# DATABASE_URL=postgresql://usuario:senha@db:5432/tculeads
DATABASE_URL=sqlite:///./tcu_leads.db

# ---- Segurança ----
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio

# ---- Usuário administrador inicial (criado no primeiro start) ----
ADMIN_EMAIL=admin@tculeads.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# ---- IA (extração dos editais/acórdãos). Sem a chave, roda em modo regex. ----
ANTHROPIC_API_KEY=

# ---- Resumo diário por e-mail (opcional; sem SMTP não envia) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=
DIGEST_MIN_SCORE=40

# ---- Produção (proxy Nginx + HTTPS) ----
# Endereço público do sistema (subdomínio do escritório). Usado pelo frontend.
SITE_URL=https://tcu.seuescritorio.com.br

ENVIRONMENT=production
