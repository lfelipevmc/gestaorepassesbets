# Database
POSTGRES_DB=gestaobets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql://postgres:troque-por-uma-senha-forte@db:5432/gestaobets

# Security
SECRET_KEY=your-very-long-random-secret-key-here

# Microsoft 365 (Azure App Registration)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Caixa do escritório — destino da REVISÃO INTERNA dos dossiês mensais (não fala com Bets).
OFFICE_EMAIL=escritorio@seudominio.com.br
# Caixa ÚNICA e dedicada para toda a comunicação com os agentes operadores (envio e resposta).
REPASSES_MAILBOX=gestaorepasses@vascav.com.br
# Pasta-mãe onde são criadas as subpastas por confederação (organização das mensagens).
# Valores com espaço podem ir entre aspas (os scripts também toleram sem aspas).
REPASSES_FOLDER_ROOT="Gestão de Repasses"

# Anthropic AI
ANTHROPIC_API_KEY=

# App
ENVIRONMENT=production
UPLOAD_DIR=/app/uploads
SITE_URL=https://repasses.vascav.com.br

# ---------------------------------------------------------------------------
# Backup automático (DigitalOcean Spaces)
# ---------------------------------------------------------------------------
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=haveres-repasses-backups
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Senha de criptografia dos backups (GPG). GUARDE TAMBÉM OFFLINE — se perder, os
# backups não podem ser restaurados.
BACKUP_GPG_PASSPHRASE=
# Para onde enviar alertas de falha de backup (padrão: OFFICE_EMAIL)
BACKUP_ALERT_TO=
